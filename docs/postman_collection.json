{
  "info": {
    "name": "Continuous ITV Intelligence Engine API",
    "description": "Postman API Collection for Guidewire Capstone Project",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login (Underwriter)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"underwriter\",\n  \"password\": \"Underwriter@123\"\n}"
            },
            "url": "http://localhost:8080/api/v1/auth/login"
          }
        },
        {
          "name": "Get Current Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "http://localhost:8080/api/v1/auth/me"
          }
        }
      ]
    },
    {
      "name": "Policies & Portfolio",
      "item": [
        {
          "name": "Get All Policies",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "http://localhost:8080/api/v1/policies"
          }
        },
        {
          "name": "Get Policy Detail (Scenario A)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "http://localhost:8080/api/v1/policies/1"
          }
        }
      ]
    },
    {
      "name": "Continuous Monitoring",
      "item": [
        {
          "name": "Trigger Reassessment for Policy",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "http://localhost:8080/api/v1/monitoring/evaluate/1?triggerType=MANUAL_REASSESSMENT"
          }
        },
        {
          "name": "Run Batch Daily Scan",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "http://localhost:8080/api/v1/monitoring/batch-scan"
          }
        }
      ]
    },
    {
      "name": "Evidence & Abstention",
      "item": [
        {
          "name": "Get Confidence & Abstention (Scenario B)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "http://localhost:8080/api/v1/evidence/confidence/4"
          }
        }
      ]
    },
    {
      "name": "Scenario Simulator",
      "item": [
        {
          "name": "Simulate Coverage Limits (80, 90, 95, 100, custom)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"policyId\": 1,\n  \"customCoverageLimit\": 5800000.00\n}"
            },
            "url": "http://localhost:8080/api/v1/scenarios/simulate"
          }
        }
      ]
    },
    {
      "name": "Underwriter Workflows",
      "item": [
        {
          "name": "Get Review Cases",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "http://localhost:8080/api/v1/workflows/cases"
          }
        },
        {
          "name": "Record Underwriter Decision (Approve Endorsement)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"caseId\": 1,\n  \"decisionType\": \"APPROVE_ENDORSEMENT\",\n  \"approvedCoverageLimit\": 5700000.00,\n  \"decisionNotes\": \"Approved revised dwelling endorsement to 95% ITV benchmark based on verified CPWD Plinth Area Rates 2025.\"\n}"
            },
            "url": "http://localhost:8080/api/v1/workflows/cases/decision"
          }
        }
      ]
    },
    {
      "name": "Portfolio Analytics",
      "item": [
        {
          "name": "Get Portfolio Metrics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "http://localhost:8080/api/v1/analytics/portfolio"
          }
        }
      ]
    },
    {
      "name": "Data Integrations & Importers",
      "item": [
        {
          "name": "Get All Integrations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "http://localhost:8080/api/v1/integrations"
          }
        },
        {
          "name": "Sync Integration (CPWD)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "http://localhost:8080/api/v1/integrations/sync/CPWD_PAR_2025"
          }
        },
        {
          "name": "Import Synthetic CSVs (SYNTHETIC_DEMO_DATA)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "http://localhost:8080/api/v1/integrations/import/synthetic-csv"
          }
        },
        {
          "name": "Import TN PWD Schedule of Rates 2025-26",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "http://localhost:8080/api/v1/integrations/import/pwd-rates"
          }
        },
        {
          "name": "Import DPIIT WPI Materials Series",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "http://localhost:8080/api/v1/integrations/import/wpi-series"
          }
        },
        {
          "name": "Import TN Urban Building Footprints",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "http://localhost:8080/api/v1/integrations/import/building-footprints"
          }
        }
      ]
    },
    {
      "name": "Audit & Compliance",
      "item": [
        {
          "name": "Get Recent Audit Logs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "http://localhost:8080/api/v1/audit/recent"
          }
        }
      ]
    }
  ]
}

